# Development environment for Angular project
FROM node:14-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Install Angular CLI globally (for convenience)
RUN npm install -g @angular/cli@12.2.18

# Make sure @angular-devkit/build-angular is installed even if it's missing from package.json
RUN npm install --save-dev @angular-devkit/build-angular@12.2.18

# Copy project files
COPY . .

# Create any missing TypeScript config files if needed
RUN if [ ! -f tsconfig.app.json ]; then echo '{"extends": "./tsconfig.json","compilerOptions": {"outDir": "./out-tsc/app","types": []},"files": ["src/main.ts","src/polyfills.ts"],"include": ["src/**/*.d.ts"]}' > tsconfig.app.json; fi
RUN if [ ! -f tsconfig.spec.json ]; then echo '{"extends": "./tsconfig.json","compilerOptions": {"outDir": "./out-tsc/spec","types": ["jasmine","node"]},"files": ["src/polyfills.ts"],"include": ["src/**/*.spec.ts","src/**/*.d.ts"]}' > tsconfig.spec.json; fi

# Expose port for development server
EXPOSE 4200

# Start Angular development server with host binding to make it accessible outside the container
CMD ["ng", "serve", "--host", "0.0.0.0", "--poll=2000"]
